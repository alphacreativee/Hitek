	<cssstyles>
		:root {
			--overview-hotspot-primary: #387873;
			--overview-tag-offset-x: -5px;
		}

		.overview-hotspot-tag {
			position: relative;
			z-index: 0;
			isolation: isolate;
			display: inline-block;
			overflow: visible;
			color: #FFFFFF;
			font-family: "Montserrat", sans-serif;
			font-size: 14px;
			font-weight: 600;
			line-height: 20px;
			white-space: nowrap;
			box-sizing: border-box;
			pointer-events: none;
		}

		.overview-hotspot-title {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 8px 30px;
			border: 1px solid transparent;
			border-radius: 999px;
			background:
				linear-gradient(var(--overview-hotspot-primary), var(--overview-hotspot-primary)) padding-box,
				linear-gradient(90deg, rgba(105,188,177,1) 0%, rgba(122,234,229,1) 51%, rgba(105,188,177,0.8) 100%) border-box;
			box-sizing: border-box;
			transform: translateX(var(--overview-tag-offset-x));
		}

		.overview-hotspot-subtitle {
			position: absolute;
			left: calc(30px + var(--overview-tag-offset-x));
			top: calc(100% + 8px);
			display: inline-flex;
			align-items: center;
			gap: 5px;
			color: #FFFFFF;
			font-family: "Montserrat", sans-serif;
			font-size: 11px;
			font-weight: 500;
			line-height: 14px;
			white-space: nowrap;
			pointer-events: none;
			text-shadow: 0 1px 4px rgba(0,0,0,0.35);
		}

