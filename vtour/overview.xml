		.overview-hotspot-dot {
			display: block;
			z-index: 3;
			width: 12px;
			height: 12px;
			border: 1px solid #FFFFFF;
			border-radius: 50%;
			background: radial-gradient(circle, #1F4F4B 0 3px, #387873 3px 6px, rgba(216,255,255,0.9) 100%);
			box-shadow:
				0 0 4px 2px rgba(216,255,255,0.42),
				0 0 10px 5px rgba(122,234,229,0.28),
				0 0 18px 9px rgba(56,120,115,0.18),
				0 0 30px 15px rgba(216,255,255,0.10);
			box-sizing: border-box;
			animation: overview-hotspot-dot-pulse 1.45s ease-in-out infinite;
		}

		@keyframes overview-hotspot-dot-pulse {
			0%, 100% {
				box-shadow:
					0 0 4px 2px rgba(216,255,255,0.34),
					0 0 10px 5px rgba(122,234,229,0.22),
					0 0 18px 9px rgba(56,120,115,0.14),
					0 0 30px 15px rgba(216,255,255,0.08);
				filter: brightness(1);
			}

			50% {
				box-shadow:
					0 0 6px 3px rgba(216,255,255,0.62),
					0 0 16px 8px rgba(122,234,229,0.38),
					0 0 28px 14px rgba(56,120,115,0.24),
					0 0 44px 22px rgba(216,255,255,0.14);
				filter: brightness(1.28);
			}
		}
