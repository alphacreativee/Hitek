	<action name="overview_hotspot_tag_setup" type="Javascript"><![CDATA[
		var lineHeight = caller["data-line-height"] || "80";
		lineHeight = String(lineHeight).replace("px", "").trim();
		var lineHeightNumber = parseFloat(lineHeight) || 80;
		var title = caller.html || "";
		var subtitle = caller["data-subtitle"] || "";
		var subtitleHeight = subtitle ? (caller["data-subtitle-height"] || "22") : "0";
		subtitleHeight = String(subtitleHeight).replace("px", "").trim();
		var subtitleHeightNumber = parseFloat(subtitleHeight) || 0;
		var tagHalfHeight = caller["data-tag-half-height"] || "19";
		tagHalfHeight = String(tagHalfHeight).replace("px", "").trim();
		var tagHalfHeightNumber = parseFloat(tagHalfHeight) || 19;
		caller.oy = -(lineHeightNumber - subtitleHeightNumber) + tagHalfHeightNumber;
		caller.html = '<span class="overview-hotspot-title">' + title + '</span>' +
			(subtitle ? '<span class="overview-hotspot-subtitle">' + subtitle + '</span>' : '');

		var hotspotElement = caller.sprite || caller.htmlsprite || caller.element;
		var tagElement = hotspotElement && hotspotElement.querySelector
			? (hotspotElement.querySelector(".overview-hotspot-tag") || hotspotElement)
			: hotspotElement;

		if (tagElement && tagElement.style) {
			tagElement.style.setProperty("--overview-line-height", lineHeight + "px");
			tagElement.setAttribute("data-line-height", lineHeight);
		}

		var lineName = caller.name + "_line";
		if (!krpano.get("hotspot[" + lineName + "]")) {
			krpano.call("addhotspot(" + lineName + ");");
		}

		krpano.set("hotspot[" + lineName + "].ath", caller.ath);
		krpano.set("hotspot[" + lineName + "].atv", caller.atv);
		krpano.set("hotspot[" + lineName + "].height", lineHeightNumber);
		krpano.call("hotspot[" + lineName + "].loadstyle(overview_hotspot_line);");
		krpano.set("hotspot[" + lineName + "].height", lineHeightNumber);
		krpano.set("hotspot[" + lineName + "].visible", true);

		var dotName = caller.name + "_dot";
		if (!krpano.get("hotspot[" + dotName + "]")) {
			krpano.call("addhotspot(" + dotName + ");");
		}

		krpano.set("hotspot[" + dotName + "].ath", caller.ath);
		krpano.set("hotspot[" + dotName + "].atv", caller.atv);
		krpano.call("hotspot[" + dotName + "].loadstyle(overview_hotspot_dot);");
		krpano.set("hotspot[" + dotName + "].visible", true);
	]]></action>

	<action name="overview_hotspot_open_info" type="Javascript"><![CDATA[
		var eventDetail = {
			name: caller.name,
			ath: caller.ath,
			atv: caller.atv
		};
		var event;

		if (typeof window.CustomEvent === "function") {
			event = new CustomEvent("overview:hotspot-click", {
				detail: eventDetail
			});
		} else {
			event = document.createEvent("CustomEvent");
			event.initCustomEvent("overview:hotspot-click", true, true, eventDetail);
		}

		window.dispatchEvent(event);
	]]></action>

