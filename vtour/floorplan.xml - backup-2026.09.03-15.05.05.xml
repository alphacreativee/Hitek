	       depth="1000"
	       scale="1.0"
	       alpha="1.0"
	       onover.addevent="tween(scale,1.08);"
	       onout.addevent="tween(scale,1.0);"
	       onloaded.addevent="floorplan_hotspot_float();"
	       />

	<action name="floorplan_hotspot_float" scope="local">
		copy(hs_float_name, caller.name);
		set(caller.alpha, 1.0);
		set(caller.oy, 0);
		floorplan_hotspot_float_step(get(hs_float_name), -10);
	</action>

	<action name="floorplan_hotspot_float_step" scope="local" args="hsname, targetoy">
		if(hotspot[get(hsname)],
			tween(hotspot[get(hsname)].oy, get(targetoy), 0.8, easeInOutSine,
				if(targetoy LT 0,
					floorplan_hotspot_float_step(get(hsname), 0);
				  ,
					floorplan_hotspot_float_step(get(hsname), -10);
				);
			);
		);
	</action>

	<action name="floorplan_hotspot_click" scope="local">
		if(isvalue(caller.linkedscene),
			copy(hs_linkedscene, caller.linkedscene);
			set(caller.enabled, false);
			skin_hidetooltips();
			if(caller.linkedscene_lookat, txtsplit(caller.linkedscene_lookat, ',', hs_lookat_h, hs_lookat_v, hs_lookat_fov); );
			skin_loadscene(get(hs_linkedscene), get(skin_settings.loadscene_blend));
			if(hs_lookat_h !== null, skin_lookat(get(hs_lookat_h), get(hs_lookat_v), get(hs_lookat_fov)); );
		);
	</action>

